# bootstrap.sh creates .env with fresh passwords. Do not copy empty passwords.
POSTGRES_DB=foxtube
POSTGRES_USER=foxtube_migrator
POSTGRES_PASSWORD=
API_DB_PASSWORD=
WORKER_DB_PASSWORD=
FOXTUBE_ENV=development
# Root Ubuntu bootstrap replaces this default pair with the connected LAN IPv4.
# --no-lan preserves these settings and skips managed firewall configuration.
FOXTUBE_BIND=127.0.0.1
FOXTUBE_PORT=8080
FOXTUBE_PUBLIC_ORIGIN=http://localhost:8080
# Ubuntu managed networking: flags are persisted here by configure_lan.py.
# --listen-all changes the bind; only --allow-any-source removes source limits.
FOXTUBE_LAN_LISTEN_ALL=false
FOXTUBE_LAN_ALLOW_SUBNETS=
FOXTUBE_LAN_ALLOW_ANY_SOURCE=false
# Optional IPv4 web SYN MSS clamp (536..1460); blank leaves TCP MSS unchanged.
FOXTUBE_LAN_TCP_MSS=
# Optional suffix for the locally built application/development image.
FOXTUBE_IMAGE_TAG=local
